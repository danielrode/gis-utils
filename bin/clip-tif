#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# Author: Daniel Rode
# Created: 14 Nov 2024


# Description: Clip a given raster file to a polygon.


import sys
from pathlib import Path

from vogeler.stdlib import print2
from vogeler.extlib import clip_tif


# Constants
HELP_TEXT = f"Usage: {Path(sys.argv[0]).name} SRC_TIF SHP DST_TIF"


# Main

# Parse command line arguments
args = sys.argv[1:]
try:
    rast_path = Path(args[0])
    shp_path = Path(args[1])
    out_path = Path(args[2])
except IndexError:
    print2(HELP_TEXT)
    sys.exit(1)

# Clip raster
clip_tif(rast_path, shp_path, out_path)
