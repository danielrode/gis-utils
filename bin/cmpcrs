#!/usr/bin/env python3
# author: Daniel Rode
# created: 30 Oct 2025
# updated: 12 Nov 2025


import sys
import subprocess as sp
from pathlib import Path

import pyogrio
from pyogrio.errors import DataLayerError


def get_rast_crs(fp):
    cmd = ['gdalinfo', str(fp)]
    p = sp.run(cmd, check=True, text=True, capture_output=True)
    crs = (
        p
        .stdout
        .split('\nCoordinate System is:\n')[1]
        .split('\nData axis to CRS axis mapping: ')[0]
        .strip()
    )

    return crs


def get_shp_layers(fp):
    counter = 0
    while True:
        try:
            meta = pyogrio.read_info(fp, layer=counter)
            yield meta['layer_name']
        except DataLayerError:
            return

        counter += 1


def get_vect_crss(fp):
    for layer in get_shp_layers(fp):
        cmd = ['ogrinfo', '-summary', str(fp), layer]
        p = sp.run(cmd, check=True, text=True, capture_output=True)
        crs = (
            p
            .stdout
            .split('\nLayer SRS WKT:\n')[1]
            .split('\nData axis to CRS axis mapping: ')[0]
            .strip()
        )

        yield crs


crs_list = []
for fp in sys.argv[1:]:
    fp = Path(fp)
    if not fp.exists():
        print("error: Path not found:", fp)
        exit(2)
    if fp.suffix in (
        '.tif',
        '.tiff',
    ):
        crs_list += [get_rast_crs(fp)]
    elif fp.suffix in (
        '.gdb',
        '.gkpg',
        '.shp',
        '.fgb',
    ):
        crs_list += list(get_vect_crss(fp))
    else:
        print("Unrecognized file type:", fp)

crs_match = len(set(crs_list)) == 1
print(crs_match)
if crs_match:
    sys.exit(0)
else:
    sys.exit(1)
