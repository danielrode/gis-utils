#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# Author: Daniel Rode
# Created: 20 Oct 2023
# Updated: 21 Jul 2025


import sys
from pathlib import Path

from vogeler.stdlib import print2
from vogeler.extlib import catshp


# Constants
HELP_TEXT = f"Usage: {sys.argv[0]} IN_GPKG... OUT_GPKG"


# Main

# Parse command line arguments
args = sys.argv[1:]
if len(args) < 2:
    print2(HELP_TEXT)
    sys.exit(1)

in_shp_list = args[:-1]
out_pth = Path(args[-1])

# Concatenate shapefiles into one, then save as new file
catshp(in_shp_list, out_pth)
