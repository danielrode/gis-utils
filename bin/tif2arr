#!/usr/bin/env python3
# author: daniel rode
# updated: 14 aug 2026


"""Print raster pixel values as array of numbers."""


import sys
from pathlib import Path

import rasterio as rio


EXE_NAME = Path(__file__).name
HELP = f"Usage: {EXE_NAME} TIFF_PATH [BAND_NUM]"


def print2(*args, **kwargs):
    print(*args, **kwargs, file=sys.stderr)


# Parse command line arguments
args = sys.argv[1:]
try:
    tif_fp = Path(args[0])
except IndexError:
    print2(HELP)
    sys.exit(1)

if not tif_fp.is_file():
    print2("error: File not found:", tif_fp)
    sys.exit(1)

try:
    band = args[1]
except IndexError:
    band = 1


# Main
with rio.open(tif_fp, 'r') as f:
    arr = f.read()
print(arr)
