#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# Author: Daniel Rode


# Transform a given pair of coordinates from one projection to another.


import sys
from pathlib import Path

import pyproj
from shapely.geometry import Point
from shapely.ops import transform

from vogeler.stdlib import print2


EXE_NAME = Path(sys.argv[0]).name
HELP_TEXT = f"Usage: {EXE_NAME} X Y IN_EPSG OUT_EPSG"


# Main

# Parse command line arguments
args = sys.argv[1:]
try:
    in_point = Point(args[0], args[1])
    in_epsg = pyproj.CRS(f"EPSG:{args[2]}")
    out_epsg = pyproj.CRS(f"EPSG:{args[3]}")
except IndexError:
    print2(HELP_TEXT)
    sys.exit(1)

# Re-project coordinates and show result
transformation = pyproj.Transformer.from_crs(
    in_epsg, out_epsg, always_xy=True
).transform
out_point = transform(transformation, in_point)
x, y = out_point.x, out_point.y
print(x, y)
