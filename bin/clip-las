#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# Author: Daniel Rode
# Created: 30 Sep 2024


# Description: Clip a given LiDAR file to a polygon.


import sys
from pathlib import Path

import pyogrio

from vogeler.stdlib import print2
from vogeler.lidr import clip_las


# Constants
HELP_TEXT = f"Usage: {Path(sys.argv[0]).name} SRC_LAS SHP DST_LAS"


# Main

# Parse command line arguments
try:
    args = sys.argv[1:]
    las_path, shp_path, out_path = args
except ValueError:
    print2(HELP_TEXT)
    exit(1)

out_path = Path(out_path)

# Import clipping geometry
geom = pyogrio.read_dataframe(shp_path).dissolve().geometry

# Clip point cloud and save to file
clip_las(las_path, geom, out_path)
