#!/usr/bin/env python3
# author: daniel rode
# dependencies: pdal, gdal
# created: 01 oct 2026
# updated: 03 oct 2026


"""Generate density raster of a LAS file and save as viridis JPEG."""


import sys
import json
import subprocess as sp
from pathlib import Path
from tempfile import TemporaryDirectory


GRAPH_DPI = 600
RES = 0.5
VIRIDIS_COLORMAP = '''\
0%   68  1   84
25%  59  82  139
50%  33  145 140
75%  94  201 98
100% 253 231 37
nv   255 0   255
'''


def print2(*a, **kw):
    print(*a, **kw, file=sys.stderr)

def check(proc):
    if proc.returncode != 0:
        print2("error: Command failed:", proc.args)
        sys.exit(proc.returncode)


def main():
    # Parse command line arguments
    src_las = Path(sys.argv[1])
    dst_jpg = Path(sys.argv[2])

    with TemporaryDirectory() as td:
        # Generate density raster
        pdal_pipeline = [
            str(src_las),
            # {
            #     "type": "filters.outlier",
            #     "method": "radius",
            #     "radius": 1.0,
            #     "min_k": 8,
            # },
            # {
            #     "type": "filters.expression",
            #     "expression": "Classification != 7"
            # },
            {
                "filename": str(Path(td, 'all_count.tif')),
                "binmode": True,
                "resolution": RES,
                "gdaldriver": "GTiff",
                "dimension": "X",
                "output_type": ["count"],
            },
        ]
        p = sp.run(
            (
                'pdal',
                'pipeline',
                '--stdin',
            ),
            check=False,
            input=json.dumps(pdal_pipeline),
            text=True
        )
        check(p)

        # Apply Viridis color-map
        viridis_fp = Path(td, 'viridis.txt')
        viridis_fp.write_text(VIRIDIS_COLORMAP)
        p = sp.run(
            (
                'gdaldem',
                'color-relief',
                Path(td, 'all_count.tif'),
                str(viridis_fp),
                Path(td, 'all_count_colored.tif'),
            ),
            check=False,
        )
        check(p)

        # Render GeoTIFF as JPEG
        p = sp.run(
            (
                'gdal_translate',
                '-of', 'JPEG',
                Path(td, 'all_count_colored.tif'),
                str(dst_jpg),
            ),
            check=False,
        )
        check(p)

if __name__ == '__main__':
    main()
    sys.exit(0)
