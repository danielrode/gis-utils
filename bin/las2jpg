#!/usr/bin/env python3
# author: daniel rode
# dependencies: pdal, gdal
# created: 01 oct 2026
# updated: -


"""Generate density raster of a LAS file and save as viridis JPEG."""


import sys
import subprocess as sp
from pathlib import Path
from tempfile import TemporaryDirectory


GRAPH_DPI = 600
RES = 0.5
VIRIDIS_COLORMAP = '''\
0%   68  1   84
25%  59  82  139
50%  33  145 140
75%  94  201 98
100% 253 231 37
nv   255 0   255
'''


def main():
    # Parse command line arguments
    src_las = Path(sys.argv[1])
    dst_jpg = Path(sys.argv[2])

    with TemporaryDirectory() as td:
        # Generate density raster
        sp.run(
            (
                'pdal',
                'translate',
                str(src_las),
                Path(td, 'all_count.tif'),
                '--writers.gdal.resolution=' + str(RES),
                '--writers.gdal.output_type=count',
                '--writers.gdal.gdaldriver=GTiff',
            ),
            check=True,
        )

        # Apply Viridis color-map
        viridis_fp = Path(td, 'viridis.txt')
        viridis_fp.write_text(VIRIDIS_COLORMAP)
        sp.run(
            (
                'gdaldem',
                'color-relief',
                Path(td, 'all_count.tif'),
                str(viridis_fp),
                Path(td, 'all_count_colored.tif'),
            ),
            check=True,
        )

        # Render GeoTIFF as JPEG
        sp.run(
            (
                'gdal_translate',
                '-of', 'JPEG',
                Path(td, 'all_count_colored.tif'),
                str(dst_jpg),
            ),
            check=True,
        )

if __name__ == '__main__':
    main()
    sys.exit(0)
