#!/usr/bin/env Rscript
# Author: Daniel Rode
# Created: 14 Jun 2024


# Description: Generate a small point cloud with randomly placed points and
# save to file.


library(lidR)


# Constants
HELP_TEXT = "Usage: this.R DST_LAS"


# Main

# Parse command line arguments
args = commandArgs(trailingOnly=TRUE)
if (length(pos_args) != 1) {
    cat(HELP_TEXT)
    quit(status=1)
}
dst_path = args[1]

# Generate and save point cloud
n_points = 100
las = LAS(data = data.frame(
    X = runif(n_points, 0, 100),  # Random X coordinates (meters)
    Y = runif(n_points, 0, 100),  # Random Y coordinates (meters)
    Z = runif(n_points, 0, 100)   # Random elevation (meters)
))

lidR::writeLAS(las, dst_path)
