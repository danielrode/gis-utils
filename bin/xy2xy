#!/usr/bin/env python3
# author: daniel rode


"""Transform a given pair of coordinates from one projection to another."""


import sys
from pathlib import Path

import pyproj
from shapely.geometry import Point
from shapely.ops import transform

from vogeler.stdlib import print2


LATLON_EPSG = 4326

EXE_NAME = Path(__file__).name

HELP_TEXT = f"Usage: {EXE_NAME} X,Y IN_EPSG OUT_EPSG"

in_epsg = None
out_epsg = None
if EXE_NAME == 'xy2xy-2lonlat':
    HELP_TEXT = f"Usage: {EXE_NAME} X,Y IN_EPSG"
    out_epsg = LATLON_EPSG
elif EXE_NAME == 'xy2xy-lonlat2':
    HELP_TEXT = f"Usage: {EXE_NAME} X,Y OUT_EPSG"
    in_epsg = LATLON_EPSG


# Parse command line arguments
args = iter(sys.argv[1:])
try:
    in_point = Point(next(args).split(','))
    if in_epsg is None:
        in_epsg = pyproj.CRS(f"EPSG:{next(args)}")
    if out_epsg is None:
        out_epsg = pyproj.CRS(f"EPSG:{next(args)}")
except (StopIteration, TypeError):
    print2(HELP_TEXT)
    sys.exit(1)

# Re-project coordinates and show result
transformation = pyproj.Transformer.from_crs(
    in_epsg, out_epsg, always_xy=True
).transform
out_point = transform(transformation, in_point)
x, y = out_point.x, out_point.y

print(f'{x},{y}')
