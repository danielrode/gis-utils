# Compare GeoTIFFs.
# tags: rastcmp, compare_rast
#
# Compare two rasters. If each corrosponding pixel is identical, exit 0.
# Otherwise, exit 1.


import sys
from pathlib import Path

import numpy as np
import rasterio as rio


# todo
# HELP = "Usage: ..."


# Main
args = sys.argv[1:]
rast_a_fp, rast_b_fp = [Path(a) for a in args]

with rio.open(rast_a_fp, 'r') as f:
    rast_a = f.read()

with rio.open(rast_b_fp, 'r') as f:
    rast_b = f.read()

rasts_identical = np.array_equal(rast_a, rast_b)
if rasts_identical:
    sys.exit(0)
sys.exit(1)
