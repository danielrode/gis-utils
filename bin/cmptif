"""Compare GeoTIFFs.

Compare two rasters. If each corrosponding pixel is identical, exit 0.
Otherwise, exit 1.

tags: rastcmp, compare_rast
"""


import sys
from pathlib import Path

import numpy as np
import rasterio as rio


EXE_NAME = Path(__file__).name
HELP = f"Usage: {EXE_NAME} TIF_A TIF_B"


rast_a_fp = Path(sys.argv[1])
rast_b_fp = Path(sys.argv[2])

with (
    rio.open(rast_a_fp, 'r') as a,
    rio.open(rast_b_fp, 'r') as b,
):
    if a.width != b.width:
        sys.exit(1)
    if a.height != b.height:
        sys.exit(1)
    if a.count != b.count:
        sys.exit(1)

    for _, win in a.block_windows():
        arr_a = a.read(window=win)
        arr_b = b.read(window=win)

        if not np.array_equal(arr_a, arr_b, equal_nan=True):
            sys.exit(1)

sys.exit(0)
